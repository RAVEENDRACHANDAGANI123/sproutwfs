# Application Settings
PROJECT_NAME="SproutWFS HR"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security & Secrets (Change in Production)
SECRET_KEY=sprout_dev_secret_key_change_in_production_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sprout_user
POSTGRES_PASSWORD=sprout_dev_password
POSTGRES_DB=sprout_hr_db
DATABASE_URL=postgresql+asyncpg://sprout_user:sprout_dev_password@localhost:5432/sprout_hr_db

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://sproutwfs.com"]
